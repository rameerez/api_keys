<%# Shared form for creating and editing API Keys %>
<%= form_with(model: [:keys, api_key], url: (api_key.persisted? ? key_path(api_key) : keys_path),
              local: true, html: { id: "api-keys-key-form" }) do |form| %>
  <% if api_key.errors.any? %>
    <div class="api-keys-form-errors">
      <strong><%= pluralize(api_key.errors.count, "error") %> prohibited this API key from being saved:</strong>
      <ul>
        <% api_key.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# Fields only available on NEW %>
  <% unless api_key.persisted? %>
    <%# Key Type selector (only shown when key_types feature is enabled) %>
    <% if ApiKeys.configuration.key_types.present? && ApiKeys.configuration.key_types.any? %>
      <div>
        <%= form.label :key_type, "Key Type" %>
        <%= form.select :key_type,
            options_for_select(
              ApiKeys.configuration.key_types.map { |type, config|
                label = type.to_s.humanize
                label += " (#{config[:prefix]}_)" if config[:prefix]
                [label, type.to_s]
              },
              api_key.key_type
            ),
            { prompt: "Select key type..." }
        %>
        <% ApiKeys.configuration.key_types.each do |type, config| %>
          <% if config[:permissions] != :all %>
            <small class="api-keys-form-help">
              <strong><%= type.to_s.humanize %>:</strong>
              <% if ApiKeys::ApiKey.scopes_follow_ceiling_for?(config) %>
                Always has exactly the <%= config[:permissions].join(", ") %> permissions
              <% else %>
                Limited to <%= config[:permissions]&.join(", ") || "no" %> permissions
              <% end %>
              <% unless config.fetch(:revocable, true) %>
                <em>(cannot be revoked)</em>
              <% end %>
            </small>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <div>
      <%= form.label :name, "Name (optional)" %>
      <%= form.text_field :name, placeholder: "e.g., myproject-production-key" %>
    </div>

    <div data-api-keys-expiration>
      <%= form.label :expires_at_preset, "Expiration" %>
      <%= form.select :expires_at_preset,
          options_for_select([
            ["No Expiration", "no_expiration"],
            ["7 days", "7_days"],
            ["30 days", "30_days"],
            ["60 days", "60_days"],
            ["90 days", "90_days"],
            ["365 days", "365_days"] # Common presets
          ], api_key.expires_at_preset.presence || (api_key.expires_at.present? ? nil : "no_expiration")), # Default selection
          {}, # html options
          {} # data attributes
      %>
    </div>

    <%# The offered scopes are the owner's default scopes. The controller reads %>
    <%# the same list (dashboard_scope_choices) when it saves the form. A key type %>
    <%# with `scopes: :ceiling` has no scopes to choose: the script below hides and %>
    <%# disables these boxes and shows that type's live permissions instead, and %>
    <%# the controller ignores scopes submitted for it. %>
    <% @available_scopes = dashboard_scope_choices %>
    <% if @available_scopes.present? %>
      <%= tag.div data: { api_keys_scope_choices: "" }, hidden: api_key.scopes_follow_ceiling? do %>
        <%= form.label :scopes, "Permissions" %>
        <%# Browsers omit unchecked boxes, so clearing every box would send no scopes %>
        <%# parameter at all and the key would silently get the defaults. This empty %>
        <%# sentinel makes "none" explicit; blank values are stripped server-side. %>
        <%# (Scopes are configured here, so an empty list grants nothing.) %>
        <%= hidden_field_tag "#{form.object_name}[scopes][]", "", id: nil if api_key.scopes_enforced? %>
        <%# A fresh form starts with every scope checked; after a failed submission %>
        <%# it shows exactly what was submitted, so a cleared box stays cleared. %>
        <% submitted_scopes = @submitted_scopes %>
        <% @available_scopes.each do |scope| %>
          <div class="form-check">
            <%= form.check_box :scopes,
                               { multiple: true, # Submits as an array
                                 class: "form-check-input",
                                 checked: submitted_scopes.nil? || submitted_scopes.include?(scope),
                                 id: "api_key_scopes_#{scope.parameterize}" }, # Unique ID
                               scope, # Value submitted when checked
                               nil # Value submitted when unchecked (not needed here)
                               %>
            <%= form.label "scopes_#{scope.parameterize}", class: "form-check-label" do %><code><%= scope %></code><% end %>
          </div>
        <% end %>
      <% end %>
    <% end %>

    <% ApiKeys.configuration.key_types.to_h.each do |type, config| %>
      <% next unless ApiKeys::ApiKey.scopes_follow_ceiling_for?(config) %>
      <%= tag.div class: "api-keys-ceiling-scopes", data: { api_keys_ceiling_contract: type.to_s },
                  hidden: api_key.key_type.to_s != type.to_s do %>
        <p><strong>Permissions</strong></p>
        <% config[:permissions].each do |scope| %>
          <kbd class="tag is-small"><%= scope %></kbd>
        <% end %>
        <small class="api-keys-form-help">
          <%= type.to_s.humanize %> keys always have exactly these permissions, and follow the key type when it changes.
        </small>
      <% end %>
    <% end %>

    <%= render "api_keys/keys/restriction_fields", form: form, api_key: api_key %>

  <% end %>

  <%# Fields editable on EDIT %>
  <% if api_key.persisted? %>
    <div>
      <%= form.label :name, "Key Name (optional)" %>
      <%= form.text_field :name %>
    </div>

    <%# A `scopes: :ceiling` key is authorized by its type's live permissions and %>
    <%# its stored scopes are metadata, so the form shows the live ceiling and %>
    <%# offers nothing to edit; the controller ignores scopes submitted for it. %>
    <%# Any other key gets the owner's default scopes as boxes, and a save edits %>
    <%# only those: it keeps every other scope the key holds, except scopes its %>
    <%# type no longer allows (ApiKey#scopes_after_form_edit). %>
    <% @available_scopes = dashboard_scope_choices %>
    <% dropped_scopes = api_key.scopes_follow_ceiling? ? [] : Array(api_key.scopes).reject { |scope| api_key.scope_within_ceiling?(scope) } %>
    <% if dropped_scopes.any? %>
      <small class="api-keys-form-help">
        <%= safe_join(dropped_scopes.map { |scope| content_tag(:code, scope) }, ", ") %>
        <%= dropped_scopes.one? ? "is" : "are" %> no longer allowed for this key and will be removed when you save.
      </small>
    <% end %>
    <% if api_key.scopes_follow_ceiling? %>
      <div class="api-keys-ceiling-scopes">
        <p><strong>Permissions / Scopes</strong></p>
        <% api_keys_displayed_scopes(api_key).each do |scope| %>
          <kbd class="tag is-small"><%= scope %></kbd>
        <% end %>
        <small class="api-keys-form-help">
          Permissions follow the <%= api_key.key_type.humanize.downcase %> key type and update automatically when it changes.
        </small>
      </div>
    <% elsif @available_scopes.present? %>
      <div>
        <%= form.label :scopes, "Permissions / Scopes" %>
        <%# Empty sentinel: clearing every box must remove every offered scope, not keep the old ones. %>
        <%= hidden_field_tag "#{form.object_name}[scopes][]", "", id: nil if api_key.scopes_enforced? %>
        <% kept_scopes = Array(api_key.scopes) - @available_scopes - dropped_scopes %>
        <% if kept_scopes.any? %>
          <small class="api-keys-form-help">
            This key also holds <%= safe_join(kept_scopes.map { |scope| content_tag(:code, scope) }, ", ") %>,
            which this form does not change.
          </small>
        <% end %>
        <% @available_scopes.each do |scope| %>
          <div class="form-check">
            <%= form.check_box :scopes,
                               { multiple: true, # Submits as an array
                                 class: "form-check-input",
                                 checked: api_key.scopes&.include?(scope) && !dropped_scopes.include?(scope),
                                 id: "api_key_scopes_#{scope.parameterize}_edit" }, # Unique ID for edit form
                               scope, # Value submitted when checked
                               nil # Value submitted when unchecked (not needed here)
                               %>
            <%# Using the scope name directly for the label's `for` attribute requires matching the checkbox ID %>
            <%= form.label "scopes_#{scope.parameterize}_edit", class: "form-check-label" do %><code><%= scope %></code><% end %>
          </div>
        <% end %>
      </div>
    <% end %>

    <%= render "api_keys/keys/restriction_fields", form: form, api_key: api_key %>
  <% end %>

  <div>
    <% if api_key.persisted? %>
      <%= form.submit "Update Key" %>
      <%= link_to "Cancel", keys_path %>
    <% else %>
      <h4><strong>Keep it safe</strong></h4>
      <p>Secret API keys are only shown once after creation. Copy the new key immediately and store it securely.</p>
      <%= form.submit "Create API Key" %>
      <%= link_to "Cancel", keys_path %>
    <% end %>
  </div>
<% end %>

<% if !api_key.persisted? && ApiKeys.configuration.key_types.present? %>
  <% key_type_policies = ApiKeys.configuration.key_types.to_h do |type, config| %>
    <% [type.to_s, {
      restrictions: ApiKeys::ApiKey.restriction_kinds_for(config).map(&:to_s),
      expirable: ApiKeys::ApiKey.revocable_for(config),
      ceiling: ApiKeys::ApiKey.scopes_follow_ceiling_for?(config)
    }] %>
  <% end %>
  <script nonce="<%= content_security_policy_nonce %>">
    (() => {
      const form = document.getElementById("api-keys-key-form");
      const keyType = form && form.querySelector("#api_key_key_type");
      if (!form || !keyType) return;

      const policies = <%= raw json_escape(key_type_policies.to_json) %>;
      const updatePolicyFields = () => {
        const policy = policies[keyType.value];

        form.querySelectorAll("[data-api-keys-restriction-kind]").forEach((container) => {
          const enabled = policy && policy.restrictions.includes(container.dataset.apiKeysRestrictionKind);
          container.hidden = !enabled;
          container.querySelectorAll("input, select, textarea").forEach((input) => { input.disabled = !enabled; });
        });

        form.querySelectorAll("[data-api-keys-expiration]").forEach((container) => {
          const enabled = policy && policy.expirable;
          container.hidden = !enabled;
          container.querySelectorAll("input, select, textarea").forEach((input) => { input.disabled = !enabled; });
        });

        // A scopes: :ceiling type has no scopes to choose: hide and disable the
        // boxes (so none are submitted) and show that type's live permissions.
        const ceiling = Boolean(policy && policy.ceiling);
        form.querySelectorAll("[data-api-keys-scope-choices]").forEach((container) => {
          container.hidden = ceiling;
          container.querySelectorAll("input, select, textarea").forEach((input) => { input.disabled = ceiling; });
        });
        form.querySelectorAll("[data-api-keys-ceiling-contract]").forEach((container) => {
          container.hidden = !(ceiling && container.dataset.apiKeysCeilingContract === keyType.value);
        });
      };

      keyType.addEventListener("change", updatePolicyFields);
      updatePolicyFields();
    })();
  </script>
<% end %>
