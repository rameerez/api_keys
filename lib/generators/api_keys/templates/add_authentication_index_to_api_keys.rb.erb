  end

  private

  # Concurrently on PostgreSQL (and PostGIS). MySQL and SQLite have no
  # concurrent build and refuse the option.
  def index_algorithm
    connection.adapter_name.downcase.include?("postg") ? { algorithm: :concurrently } : {}
  end

  # A concurrent build that fails (a lock or statement timeout, for example)
  # leaves an invalid index on PostgreSQL, which index_exists? still finds.
  # Treat it as absent: remove it, so that the next step builds it again.
  # (IndexDefinition#valid? exists from Rails 7.1. The migrator's lock keeps
  # a second run from removing an index that another run still builds.)
  def remove_invalid_index
    index = connection.indexes(:api_keys).find { |candidate| candidate.name == INDEX_NAME }
    return unless index.respond_to?(:valid?) && !index.valid?

    remove_index :api_keys, name: INDEX_NAME, **index_algorithm
  end
end
