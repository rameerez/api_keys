# frozen_string_literal: true

# On PostgreSQL the index is built concurrently, outside a transaction, so
# api_keys takes writes while it builds, and strong_migrations accepts the
# migration. If a concurrent build fails, PostgreSQL keeps an invalid index;
# the next run removes it and builds it again.
class AddAuthenticationIndexToApiKeys < ActiveRecord::Migration<%= migration_version %>
  INDEX_NAME = "index_api_keys_authentication_lookup"
  COLUMNS = %i[prefix last4 digest_algorithm].freeze

  disable_ddl_transaction!

  def up
    remove_invalid_index
